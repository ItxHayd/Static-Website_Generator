<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= page.title %> | <%= siteName %></title>

  <!-- CSS -->
  <link rel="stylesheet" href="/assets/css/comfort.css">
</head>

<body>

  <header class="nav">
    <div class="logo"><%= siteName %></div>
    <nav>
      <a href="/">Home</a>
      <a href="/about.html">About</a>
    </nav>
  </header>

  <section class="hero">
    <img src="/assets/images/hero.jpg" alt="Hero Image">
    <div class="hero-text">
      <h1><%= page.title %></h1>
      <p>Welcome to Comfort Layout</p>
    </div>
  </section>

  <main class="content">
    <%- body %>
  </main>

  <footer>
    <p>© <%= siteName %> - All rights reserved</p>
  </footer>

  <!-- JS -->
  <script src="/assets/js/comfort.js"></script>

</body>
</html>