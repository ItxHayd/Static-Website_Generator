<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title><%= page.title %></title>

  <style>
    body {
      background: #0a0a0a;
      color: #00ff9f;
      font-family: monospace;
      padding: 40px;
    }

    .box {
      border: 1px solid #00ff9f;
      padding: 20px;
      border-radius: 6px;
    }

    a { color: #00c2ff; }
  </style>
</head>

<body>
  <div class="box">
    <h1>$ <%= page.title %></h1>
    <%- body %>
  </div>
</body>
</html>