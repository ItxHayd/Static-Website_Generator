<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= page.title %> | <%= siteName %></title>

  <style>
    body {
      font-family: system-ui, Arial;
      margin: 0;
      background: #0f172a;
      color: #e2e8f0;
      line-height: 1.6;
    }

    header {
      padding: 20px;
      background: #111827;
      border-bottom: 1px solid #1f2937;
    }

    main {
      max-width: 800px;
      margin: 40px auto;
      padding: 0 20px;
    }

    a { color: #38bdf8; }
  </style>
</head>

<body>
  <header>
    <h2><%= siteName %></h2>
  </header>

  <main>
    <h1><%= page.title %></h1>
    <%- body %>
  </main>
</body>
</html>